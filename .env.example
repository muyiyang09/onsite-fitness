# === 上门体育 · 环境变量配置 ===
# 复制此文件为 .env 并修改对应值

# MySQL（§6.17：root 仅初始化用，应用账号 sports_app 走下面两项）
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=sports_app
MYSQL_APP_PASSWORD=

# Redis（§6.37：生产必须设密码）
REDIS_PASSWORD=

# Milvus MinIO 凭据（§6.16：禁止默认 minioadmin）
MILVUS_MINIO_ACCESS_KEY=
MILVUS_MINIO_SECRET_KEY=

# === JWT 签名密钥 + AES 加密密钥（§6.14）===
# 生产必填，缺失后端启动即失败；生成方式：openssl rand -hex 32（三个 JWT key 各生成一个）
# ONSITE_AES_KEY 必须为 16/24/32 字节（如 openssl rand -hex 16 生成 32 位十六进制 = 16 字节）
# ⚠️ git 历史中的旧密钥视为已泄露，上线前务必轮换新值
ONSITE_JWT_ADMIN_KEY=
ONSITE_JWT_USER_KEY=
ONSITE_JWT_COACH_KEY=
ONSITE_AES_KEY=

# 阿里云 OSS（可选，不配则图片上传不可用）
ONSITE_OSS_AK=
ONSITE_OSS_SK=
ONSITE_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ONSITE_OSS_BUCKET=

# 微信小程序 & 支付（可选，不配则支付功能不可用）
ONSITE_WX_APPID=
ONSITE_WX_SECRET=
ONSITE_WX_MCHID=
ONSITE_WX_MCH_SERIAL=
ONSITE_WX_API_V3_KEY=
ONSITE_WX_NOTIFY_URL=http://localhost:8080/notify/paySuccess
ONSITE_WX_REFUND_NOTIFY_URL=http://localhost:8080/notify/refundSuccess

# 百度地图 AK（可选）
ONSITE_BAIDU_AK=

# === Milvus 向量库（AI 服务向量召回用） ===
# 本地 docker-compose 部署默认无需 token；使用 Zilliz Cloud 等云托管时填 apikey
# URI / database / collection / 维度等本地默认值见 ai-service/.env.example
MILVUS_TOKEN=

# === 后端 ↔ AI 微服务 机器间鉴权（§6.13） ===
# 共享密钥：后端与 ai-service 同时注入同一值；不填则 /v1/ai/* 一律 401
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
SERVICE_AUTH_TOKEN=
