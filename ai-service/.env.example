# ===== LLM =====
# LiteLLM 统一路由：推荐优先 DeepSeek（便宜 + 中文好）
# 模型名格式参考 litellm 官方：deepseek/deepseek-chat / openai/gpt-4o-mini / qwen/qwen-plus
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 自建兼容端点可以填（DeepSeek 官方默认是 https://api.deepseek.com/v1 可以不填）
LLM_BASE_URL=

# ===== 现有后端数据库（只读） =====
# 与 spring boot 共用同一个 sports_takeout，账号给只读权限即可
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sports_takeout

# ===== 现有后端 Redis（可选：推荐结果缓存 24h） =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# ===== HTTP 服务 =====
SERVICE_HOST=0.0.0.0
SERVICE_PORT=18000
SERVICE_ENV=dev

# ===== MCP 工具层（#07，默认关：单 Agent 单进程直接调用够用） =====
MCP_ENABLED=false
MCP_SERVER_PORT=18001
MCP_SERVER_URL=http://localhost:18001/mcp

# ===== 多 Agent（#08） =====
REVIEW_SUMMARY_ENABLED=true
CERT_REVIEW_ENABLED=true
SUPERVISOR_ENABLED=false
HITL_ENABLED=false

# ===== Checkpointer（上线加固：崩溃恢复 + 多副本共享 + DB 灾备） =====
CHECKPOINTER_BACKEND=memory     # memory（开发）/ redis（生产，多副本共享 + TTL）
CHECKPOINT_TTL_MINUTES=60
CHECKPOINT_DB_FALLBACK=true     # DB 灾备层：Redis miss 时从 DB 读 state 回填（生产默认开）

# ===== 混合检索（#04 RAG 升级） =====
# BM25 便宜且离线可跑，默认开；向量/重排依赖 bge-m3/FlagEmbedding 重模型，默认关（国内难下载）。
HYBRID_RETRIEVAL_ENABLED=true
RERANKER_ENABLED=false
BM25_TOP_K=50
RRF_K=60
RRF_TOP_K=30
# 预留：接入重模型时才需要改下面这些
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=true
VECTOR_SKIP_INITIAL_UPSERT=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_USE_FP16=true

# ===== 向量库：Milvus（生产唯一） =====
# 本地部署：docker run -d --name milvus -p 19530:19530 milvusdb/milvus:latest
# 云托管：Zilliz Cloud（uri 用 https://xxx.zillizcloud.com，token 用 apikey）
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=ai_vector_coach       # AI 服务专用 collection（加 ai_ 前缀与业务表隔离）
MILVUS_DIM=1024                         # bge-m3 输出维度=1024

# ===== Langfuse LLM 可观测性（#13，默认关） =====
# Langfuse = LLM 语义层 trace（行车记录仪）：节点 span 树 + 每次调用的完整 prompt/输出/
# 真实 usage 成本 + badcase 一键回流评测集。日志回答「快不快、挂没挂」，它回答「为什么这么答」。
# 开启步骤：① pip install -e ".[langfuse]"  ② 到 https://cloud.langfuse.com（或自部署）建项目拿 Key
# fail-open 纪律：Langfuse 不可达只丢 trace 不影响主流程；停机前自动 flush。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0                # 0~1 采样率；高峰期调低，坏 case 按 request_id 精确查
